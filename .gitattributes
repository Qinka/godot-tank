# Auto detect text files and perform LF normalization
* text=auto

# Godot specific files
*.tscn text eol=lf
*.gd text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.godot text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary

# Audio
*.wav binary
*.ogg binary
*.mp3 binary

# Fonts
*.ttf binary
*.otf binary

# Archives
*.zip binary
*.gz binary
*.tar binary
*.7z binary
